{
  "name": "bot",
  "version": "1.0.0",
  "description": "Bot de Discord del grupo: GIFs, XP y ranking de participación",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "preview": "npm run build && node dist/preview/server.js",
    "db:backup": "node dist/cli/backup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "private": true,
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
