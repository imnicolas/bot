DISCORD_TOKEN=
DATABASE_PATH=./data/bot.sqlite
FEATURE_SOCIAL_ENABLED=true
FEATURE_MEALS_ENABLED=true
FEATURE_LEVELS_ENABLED=false
FEATURE_GIFTS_ENABLED=false
# Completar antes de habilitar regalos. El CSV se importa con gifts:import.
GIFTS_GUILD_ID=
GIFTS_CHANNEL_ID=
GIFTS_ROLE_ID=
# Canales que deben quedar ocultos; el canal de avisos siempre se incluye.
GIFTS_PROTECTED_CHANNEL_IDS=
GIFTS_TIME_ZONE=America/Montevideo
# Los dos administradores humanos: si cumple uno, el aviso privado va al otro.
GIFTS_ADMIN_IDS=
# Cuenta de la pareja cuyo regalo se coordina fuera de Discord: sólo aviso privado.
GIFTS_DM_ONLY_ADMIN_ID=
# Comando temporal !cumple @persona: simulación sin cambios ni privados reales.
GIFTS_TEST_COMMAND_ENABLED=false
GIFTS_TEST_CHANNEL_ID=
